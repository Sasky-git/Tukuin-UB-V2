rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(me()))
        && get(/databases/$(database)/documents/users/$(me())).data.role == 'admin';
    }
    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(me()))
        && get(/databases/$(database)/documents/users/$(me())).data.status == 'active';
    }
    match /users/{uid} {
      allow read: if true;
      allow write: if false; // Penulisan hanya via Netlify Functions + Admin SDK.
    }
    match /privateUsers/{uid} {
      allow read: if active() && (me() == uid || admin());
      allow write: if false;
    }
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /orders/{id} {
      allow read: if active() && (admin() || resource.data.buyerId == me() || resource.data.sellerId == me());
      allow write: if false;
    }
    match /reports/{id} {
      allow read: if active() && (admin() || resource.data.reporterId == me());
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if active() && (admin() || resource.data.userId == me());
      allow write: if false;
    }
    match /activity/{id} {
      allow read: if active() && admin();
      allow write: if false;
    }
    match /productContacts/{id} {
      allow read, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
